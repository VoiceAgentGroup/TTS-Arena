# =============================================================================
# TTS ARENA ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env and fill in your actual values

# =============================================================================
# CORE APPLICATION SETTINGS
# =============================================================================
SECRET_KEY=your-secret-key-here
DATABASE_URI=sqlite:///tts_arena.db
ADMIN_ACCESS_ENABLED=true

# =============================================================================
# HUGGING FACE CONFIGURATION (Required for Seed-TTS)
# =============================================================================
HF_TOKEN=your-huggingface-token-here
ZEROGPU_TOKENS=token1,token2,token3

# =============================================================================
# TTS CACHE (DISABLED)
# =============================================================================
# TTS cache has been disabled and removed for simplicity

# =============================================================================
# CLOUDFLARE TURNSTILE (Bot Protection)
# =============================================================================
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
TURNSTILE_TIMEOUT_HOURS=24

# =============================================================================
# CURRENTLY ACTIVE TTS PROVIDERS
# =============================================================================

# MiniMax (Required for minimax-02-hd model)
MINIMAX_API_KEY=your-minimax-api-key
MINIMAX_GROUP_ID=your-minimax-group-id

# =============================================================================
# OPTIONAL TTS PROVIDERS (Currently disabled - uncomment models in tts.py to use)
# =============================================================================

# ElevenLabs (Not currently active)
# ELEVENLABS_API_KEY=your-elevenlabs-api-key

# PlayHT (Not currently active)
# PLAYHT_API_KEY=your-playht-api-key
# PLAYHT_USER_ID=your-playht-user-id
# PLAY_USERID=your-playht-user-id
# PLAY_SECRETKEY=your-playht-api-key

# Cartesia (Not currently active)
# CARTESIA_API_KEY=your-cartesia-api-key

# Hume AI (Not currently active)
# HUME_API_KEY=your-hume-api-key

# Papla (Not currently active)
# PAPLA_API_KEY=your-papla-api-key

# Lanternfish (Not currently active)
# LANTERNFISH_API_URL=your-lanternfish-api-url
# LANTERNFISH_API_KEY=your-lanternfish-api-key
# LANTERNFISH_MODEL=your-lanternfish-model-name

# =============================================================================
# LEGACY/DEPRECATED (Keep for backwards compatibility)
# =============================================================================
FAL_KEY=your-fal-key
OAUTH_CLIENT_ID=your-huggingface-client-id
OAUTH_CLIENT_SECRET=your-huggingface-client-secret